    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "dotenv": "^16.4.1",
    "playwright": "^1.41.0",
    "proxy-chain": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
