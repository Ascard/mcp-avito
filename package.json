{
  "name": "avito-scraper",
  "version": "1.0.0",
  "description": "Modular Avito scraper with CLI, MCP server, and proxy support",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "avito-scraper": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
