# Browser settings
HEADLESS=true
TIMEOUT=30000

# Anti-captcha settings (optional)
ANTICAPTCHA_API_KEY=

# Proxy settings (optional)
PROXY_ENABLED=false
PROXY_LIST_FILE=./config/proxies.txt
PROXY_ROTATION=sequential
PROXY_ROTATE_ON_ERROR=true
PROXY_ROTATE_EVERY_N=10

# Delays (anti-bot)
DELAY_MIN=1000
DELAY_MAX=3000

# Output
DEFAULT_OUTPUT=console
